# Copy to .env.local to run PomoGator on your own computer. On Vercel, add these under
# Project → Settings → Environment Variables instead. Never commit real values.
# Every service is optional: without any keys the timer, quiz loop UI, documents and stats still work locally.

# --- Accounts and sync (Supabase → Connect, or Project Settings → API Keys) ---
# Public by design: the browser uses them, and row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- AI quizzes, plans and the study assistant ---
# Server only: never prefix these with NEXT_PUBLIC_. Set one or both; with both, Claude answers and Gemini is the backup.
# Claude (console.anthropic.com → API keys). Paid per use from prepaid credit; the smallest model is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=gemini        # put Gemini first even when a Claude key is set
# Gemini (Google AI Studio → Get API key). Free tier.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_BACKUP=gemini-flash-lite-latest
# Daily AI calls per signed-in account (needs Supabase migration 3). Defaults: 150 with Gemini, 60 when Claude answers.
# Guests get no AI at all.
# AI_DAILY_LIMIT_USER=150

# --- Bot check for sign-ins (Cloudflare Turnstile → Add widget → Site key). Public by design; optional. ---
# Set this only together with Supabase → Authentication → Attack Protection → CAPTCHA (provider Turnstile, with the
# widget's Secret key there). Without it the site sends no CAPTCHA token, so don't switch CAPTCHA on in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Photo backgrounds (unsplash.com/developers → Your apps → Access Key). Server only. ---
UNSPLASH_ACCESS_KEY=

# Last.fm "now playing" (works with any music app that scrobbles): a free API key from last.fm/api/account/create.
# Server only.
LASTFM_API_KEY=

{
  "name": "pomogator",
  "version": "0.1.0",
  "private": true,
  "description": "A Pomodoro study timer that quizzes you on what you studied, sets your break from your score, and plans your next session.",
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sync": "playwright test -c playwright.sync.config.ts",
    "test:ai": "playwright test -c playwright.ai.config.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tesseract.js-data/eng": "1.0.0",
    "immer": "10.2.0",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "motion": "14.2.0",
    "next": "15.5.26",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "6.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "pg": "8.23.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
